QWidget {
    background-color: #1a1212;
    color: #eee6e6;
    font-family: "Segoe UI", "Inter", "Ubuntu", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: rgba(18, 20, 26, 235);
    border: 1px solid #2f2323;
    border-radius: 18px;
}

QDialog QTabWidget::pane {
    background-color: #1c1414;
}

QDialog QLabel {
    color: #dccfcf;
}

QMenuBar {
    background-color: #181010;
    color: #ad9a9b;
    border: none;
    border-bottom: 1px solid #271c1c;
    padding: 6px 10px;
    spacing: 2px;
}

QMenuBar::item {
    background-color: transparent;
    border: none;
    padding: 6px 14px;
    margin: 0 1px;
    border-radius: 8px;
    font-weight: 500;
    color: #ad9a9b;
}

QMenuBar::item:selected {
    background-color: #251a1a;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background-color: #fe573d;
    color: #ffffff;
}

QMenu {
    background-color: #251a1a;
    border: 1px solid #3a2b2a;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 20px;
    border-radius: 6px;
    margin: 2px;
}

QMenu::item:selected {
    background-color: #fe573d;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #dcdfe8;
    background-color: #0e0a0a;
}

QMenu::separator {
    height: 1px;
    background: #3a2b2a;
    margin: 6px 4px;
}

QPushButton {
    background-color: #2c1e1e;
    color: #eee6e6;
    border: 1px solid #3a2b2a;
    border-radius: 24px;
    padding: 9px 24px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #3c2726;
    border: 1px solid #ff725c;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #ff7d6c;
    border: 1px solid #ff9e8f;
    color: #ffffff;
    padding: 10px 24px 8px 24px;
}

QPushButton:disabled {
    background-color: #0e0a0a;
    color: #dcdfe8;
    border: 1px solid transparent;
}

QPushButton#primaryButton {
    background-color: #fe573d;
    border: 1px solid #fe573d;
    color: #ffffff;
    border-radius: 24px;
}

QPushButton#primaryButton:hover {
    background-color: #ff725c;
    border: 1px solid #ff9e8f;
}

QPushButton#primaryButton:pressed {
    background-color: #ff9e8f;
    border: 1px solid #ffc9c2;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 22px;
    padding: 8px;
}

QToolButton:hover {
    background-color: #3c2726;
    border: 1px solid #fe573d;
}

QToolButton:pressed {
    background-color: #ff7d6c;
    border: 1px solid #ff9e8f;
    padding: 9px 7px 7px 9px;
}
QToolButton:disabled {
    background-color: #0e0a0a;
    color: #dcdfe8;
    border: 1px solid transparent;
}

QMenuBar::item:disabled {
    background-color: #0e0a0a;
    color: #dcdfe8;
    border: 1px solid transparent;
}


QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #241919;
    border: 1px solid #3a2b2a;
    border-radius: 10px;
    padding: 6px 10px;
    selection-background-color: #fe573d;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus {
    border: 1px solid #fe573d;
}

QComboBox {
    background-color: #241919;
    border: 1px solid #3a2b2a;
    border-radius: 10px;
    padding: 6px 12px;
}

QComboBox:hover {
    border: 1px solid #fe573d;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #251a1a;
    border: 1px solid #3a2b2a;
    border-radius: 10px;
    selection-background-color: #fe573d;
    outline: none;
    padding: 4px;
}

QCheckBox, QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1px solid #4c3a3a;
    background-color: #241919;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #fe573d;
    border: 1px solid #fe573d;
}

/* Disabled state for form controls -- previously only QPushButton had a
   :disabled rule, so checkboxes, radio buttons, combo/spin/line edits and
   plain disabled labels all still rendered at full brightness with no way
   to tell they weren't interactive. */
QCheckBox:disabled, QRadioButton:disabled, QLabel:disabled, QGroupBox:disabled {
    background-color: #0e0a0a;
    color: #dcdfe8;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #0e0a0a;
    border: 1px solid transparent;
}

QComboBox:disabled, QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #0e0a0a;
    border: 1px solid transparent;
    color: #dcdfe8;
}


QSlider::groove:horizontal {
    height: 6px;
    background: #2f2323;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #fe573d;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: #ff725c;
}

QSlider::sub-page:horizontal {
    background: #fe573d;
    border-radius: 3px;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #3a2b2a;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #fe573d;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #3a2b2a;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #fe573d;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QTabWidget::pane {
    border: 1px solid #2f2323;
    border-radius: 12px;
    top: -1px;
}

QTabBar::tab {
    background: #211717;
    color: #ad9a9b;
    padding: 10px 20px;
    margin-right: 4px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QTabBar::tab:selected {
    background: #2c1e1e;
    color: #ffffff;
    border-bottom: 2px solid #fe573d;
}

QTabBar::tab:hover:!selected {
    background: #251a1a;
    color: #dccfcf;
}

QGroupBox {
    border: 1px solid #2f2323;
    border-radius: 14px;
    margin-top: 14px;
    padding-top: 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #ad9a9b;
}

QStatusBar {
    background: #211717;
    border-top: 1px solid #2f2323;
    color: #ad9a9b;
}

QToolTip {
    background-color: #2c1e1e;
    color: #eee6e6;
    border: 1px solid #fe573d;
    border-radius: 8px;
    padding: 6px 10px;
}

QListView, QTreeView, QTableView {
    background-color: #1c1414;
    border: 1px solid #2f2323;
    border-radius: 14px;
    outline: none;
    padding: 8px;
}

QListView::item {
    border-radius: 12px;
    padding: 10px;
    margin: 4px;
}

QListView::item:hover {
    background-color: #2c1e1e;
}

QListView::item:selected {
    background-color: #fe573d;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #211717;
    color: #ad9a9b;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #2f2323;
}

QSplitter::handle {
    background: #2f2323;
}

QProgressBar {
    background-color: #241919;
    border-radius: 8px;
    text-align: center;
    color: #eee6e6;
    border: 1px solid #3a2b2a;
}

QProgressBar::chunk {
    background-color: #fe573d;
    border-radius: 8px;
}

#libraryScreen {
    /* background is painted by LibraryScreen's animated gradient */
    background-color: transparent;
}

#libraryHeader {
    background-color: #1c1414;
    border-bottom: 1px solid #2f2323;
    padding: 16px;
}

#libraryTitle {
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
}

#gameCard {
    background-color: #251a1a;
    border: 1px solid #362626;
    border-radius: 20px;
    color: #eee6e6;
    font-weight: 600;
    padding-top: 8px;
}

#gameCard:hover {
    background-color: #2f2121;
    border: 1px solid #fe573d;
}

#gameCard:pressed {
    background-color: #3c2726;
    border: 1px solid #ff7d6c;
    padding-top: 10px;
}

#gameCardTitle {
    font-weight: 600;
    color: #ffffff;
    font-size: 13px;
}

#gameCardSubtitle {
    color: #947d7d;
    font-size: 11px;
}

#addGameTile {
    background-color: transparent;
    border: 2px dashed #3a2b2a;
    border-radius: 20px;
    color: #685656;
    font-size: 34px;
    font-weight: 300;
}

#addGameTile:hover {
    border: 2px dashed #fe573d;
    color: #ff725c;
    background-color: #211716;
}

#addGameTile:pressed {
    border: 2px solid #ff7d6c;
    color: #ff7d6c;
    background-color: #30201e;
}

#titleBarToolBar, #topMenuToolBar, QToolBar {
    background: transparent;
    border: none;
    spacing: 0px;
    padding: 0px;
    margin: 0px;
}

#customTitleBar {
    background-color: #160e0e;
    border-bottom: 1px solid #271c1c;
}

#titleBarLabel {
    color: #ad9a9b;
    font-weight: 600;
    font-size: 12px;
}

#titleBarButton {
    background: transparent;
    border: none;
    border-radius: 6px;
}

#titleBarCloseButton {
    background: transparent;
    border: none;
    border-radius: 6px;
}

#topMenuBar {
    background-color: #181010;
    border-bottom: 1px solid #271c1c;
}

#topMenuButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    font-weight: 600;
    font-size: 13px;
    color: #c8b7b7;
    padding: 2px 4px 3px 4px;
}

#topMenuButton:hover {
    background-color: #301e1c;
    border: 1px solid #fe573d;
    color: #ffffff;
}

#topMenuButton:pressed {
    background-color: #3c2726;
    border: 1px solid #ff7d6c;
    padding: 7px 4px 3px 4px;
}

#topMenuButton:disabled {
    background-color: #0e0a0a;
    color: #dcdfe8;
    border: 1px solid transparent;
}

#topMenuButton::menu-indicator {
    image: none;
    width: 0px;
}

#playButton {
    background-color: #fe573d;
    border: none;
    border-radius: 24px;
    color: #ffffff;
    font-weight: 700;
    padding: 10px 28px;
}

#playButton:hover {
    background-color: #ff725c;
}

#playButton:pressed {
    background-color: #cc442d;
}

#searchBar {
    background-color: #241919;
    border: 1px solid #3a2b2a;
    border-radius: 20px;
    padding: 8px 18px;
}

#searchBar:focus {
    border: 1px solid #fe573d;
}

#sidebarPanel {
    background-color: #170f0f;
    border-right: 1px solid #2f2323;
}

#sidebarButton {
    background-color: transparent;
    border: none;
    border-radius: 14px;
    text-align: left;
    padding: 12px 16px;
    color: #ad9a9b;
    font-weight: 600;
}

#sidebarButton:hover {
    background-color: #251a1a;
    color: #eee6e6;
}

#sidebarButton:checked {
    background-color: #5c241e;
    color: #ffffff;
}

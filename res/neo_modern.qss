QWidget {
    background-color: #0b0c10;
    color: #eef0f5;
    font-family: "Segoe UI", "Inter", "Ubuntu", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: rgba(11, 12, 16, 235);
    border: 1px solid #20232c;
    border-radius: 0;
}

QDialog QTabWidget::pane {
    background-color: #0f1015;
}

QDialog QLabel {
    color: #c6c9d6;
}

QMenuBar {
    background-color: #101218;
    color: #8d8fa3;
    border: none;
    border-bottom: 1px solid #1c1f27;
    padding: 6px 10px;
    spacing: 2px;
}

QMenuBar::item {
    background-color: transparent;
    border: none;
    padding: 6px 14px;
    margin: 0 1px;
    border-radius: 0px;
    font-weight: 500;
    color: #8d8fa3;
}

QMenuBar::item:selected {
    background-color: #121319;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background-color: #7c4dff;
    color: #ffffff;
}

QMenu {
    background-color: #121319;
    border: 1px solid #262a36;
    border-radius: 10px;
    padding: 4px;
}

QMenu::item {
    padding: 4px 16px;
    border-radius: 0px;
    margin: 0px;
    font-size: 12px;
}

QMenu::item:selected {
    background-color: #7c4dff;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #dcdfe8;
    background-color: #0a0b0e;
}

QMenu::separator {
    height: 1px;
    background: #262a36;
    margin: 3px 4px;
}

QPushButton {
    background-color: #161821;
    color: #eef0f5;
    border: 1px solid #262a36;
    border-radius: 0px;
    padding: 9px 24px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #1e2130;
    border: 1px solid #7c4dff;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #7c4dff;
    border: 1px solid #7c4dff;
    color: #ffffff;
    padding: 10px 24px 8px 24px;
}

QPushButton:disabled {
    background-color: #0a0b0e;
    color: #dcdfe8;
    border: 1px solid transparent;
}

QPushButton#primaryButton {
    background-color: #7c4dff;
    border: 1px solid #7c4dff;
    color: #ffffff;
    border-radius: 0px;
}

QPushButton#primaryButton:hover {
    background-color: #7c4dff;
    border: 1px solid #7c4dff;
}

QPushButton#primaryButton:pressed {
    background-color: #7c4dff;
    border: 1px solid #7c4dff;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 0px;
    padding: 8px;
}

QToolButton:hover {
    background-color: #1e2130;
    border: 1px solid #7c4dff;
}

QToolButton:pressed {
    background-color: #7c4dff;
    border: 1px solid #7c4dff;
    padding: 9px 7px 7px 9px;
}
QToolButton:disabled {
    background-color: #0a0b0e;
    color: #dcdfe8;
    border: 1px solid transparent;
}

QMenuBar::item:disabled {
    background-color: #0a0b0e;
    color: #dcdfe8;
    border: 1px solid transparent;
}


QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #131419;
    border: 1px solid #262a36;
    border-radius: 0px;
    padding: 6px 10px;
    selection-background-color: #7c4dff;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus {
    border: 1px solid #7c4dff;
}

QComboBox {
    background-color: #131419;
    border: 1px solid #262a36;
    border-radius: 0px;
    padding: 6px 12px;
}

QComboBox:hover {
    border: 1px solid #7c4dff;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #121319;
    border: 1px solid #262a36;
    border-radius: 0px;
    selection-background-color: #7c4dff;
    outline: none;
    padding: 4px;
}

QCheckBox, QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 0px;
    border: 1px solid #3a3f4c;
    background-color: #131419;
}

QRadioButton::indicator {
    border-radius: 0px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #7c4dff;
    border: 1px solid #7c4dff;
}

/* Disabled state for form controls -- previously only QPushButton had a
   :disabled rule, so checkboxes, radio buttons, combo/spin/line edits and
   plain disabled labels all still rendered at full brightness with no way
   to tell they weren't interactive. */
QCheckBox:disabled, QRadioButton:disabled, QLabel:disabled, QGroupBox:disabled {
    background-color: #0a0b0e;
    color: #dcdfe8;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #0a0b0e;
    border: 1px solid transparent;
}

QComboBox:disabled, QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #0a0b0e;
    border: 1px solid transparent;
    color: #dcdfe8;
}


QSlider::groove:horizontal {
    height: 6px;
    background: #20232c;
    border-radius: 0px;
}

QSlider::handle:horizontal {
    background: #7c4dff;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 0px;
}

QSlider::handle:horizontal:hover {
    background: #7c4dff;
}

QSlider::sub-page:horizontal {
    background: #7c4dff;
    border-radius: 0px;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #262a36;
    border-radius: 0px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #7c4dff;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #262a36;
    border-radius: 0px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #7c4dff;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QTabWidget::pane {
    border: 1px solid #20232c;
    border-radius: 0px;
    top: -1px;
}

QTabBar::tab {
    background: #0f1015;
    color: #8d8fa3;
    padding: 10px 20px;
    margin-right: 4px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QTabBar::tab:selected {
    background: #161821;
    color: #ffffff;
    border-bottom: 2px solid #7c4dff;
}

QTabBar::tab:hover:!selected {
    background: #121319;
    color: #c6c9d6;
}

QGroupBox {
    border: 1px solid #20232c;
    border-radius: 0px;
    margin-top: 14px;
    padding-top: 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #8d8fa3;
}

QStatusBar {
    background: #0f1015;
    border-top: 1px solid #20232c;
    color: #8d8fa3;
}

QToolTip {
    background-color: #161821;
    color: #eef0f5;
    border: 1px solid #7c4dff;
    border-radius: 0px;
    padding: 6px 10px;
}

QListView, QTreeView, QTableView {
    background-color: #0f1015;
    border: 1px solid #20232c;
    border-radius: 0px;
    outline: none;
    padding: 8px;
}

QListView::item {
    border-radius: 0px;
    padding: 10px;
    margin: 4px;
}

QListView::item:hover {
    background-color: #161821;
}

QListView::item:selected {
    background-color: #7c4dff;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #0f1015;
    color: #8d8fa3;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #20232c;
}

QSplitter::handle {
    background: #20232c;
}

QProgressBar {
    background-color: #131419;
    border-radius: 0px;
    text-align: center;
    color: #eef0f5;
    border: 1px solid #262a36;
}

QProgressBar::chunk {
    background-color: #7c4dff;
    border-radius: 0px;
}

#libraryScreen {
    /* background is painted by LibraryScreen's animated gradient */
    background-color: transparent;
}

#libraryHeader {
    background-color: #0f1015;
    border-bottom: 1px solid #20232c;
    padding: 16px;
}

#libraryTitle {
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
}

#gameCard {
    background-color: #121319;
    border: 1px solid #262b36;
    border-radius: 0px;
    color: #eef0f5;
    font-weight: 600;
    padding-top: 8px;
}

#gameCard:hover {
    background-color: #21252f;
    border: 1px solid #7c4dff;
}

#gameCard:pressed {
    background-color: #1e2130;
    border: 1px solid #7c4dff;
}

#gameCardTitle {
    font-weight: 600;
    color: #ffffff;
    font-size: 13px;
}

#gameCardSubtitle {
    color: #7c7f96;
    font-size: 11px;
}

#addGameTile {
    background-color: transparent;
    border: 2px dashed #262a36;
    border-radius: 0px;
    color: #565b68;
    font-size: 34px;
    font-weight: 300;
}

#addGameTile:hover {
    border: 2px dashed #7c4dff;
    color: #7c4dff;
    background-color: #161821;
}

#addGameTile:pressed {
    border: 2px solid #7c4dff;
    color: #7c4dff;
    background-color: #1e2130;
}

#topMenuBar {
    background-color: #121319;
    border-bottom: 1px solid #262b36;
}

#topMenuButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 0px;
    font-weight: 600;
    font-size: 13px;
    color: #b7bcc8;
    padding: 2px 4px 3px 4px;
}

#topMenuButton:hover {
    background-color: #21252f;
    border: 1px solid #7c4dff;
    color: #ffffff;
}

#topMenuButton:pressed {
    background-color: #1e2130;
    border: 1px solid #7c4dff;
    padding: 7px 4px 3px 4px;
}

#topMenuButton:disabled {
    background-color: #0a0b0e;
    color: #dcdfe8;
    border: 1px solid transparent;
}

#topMenuButton::menu-indicator {
    image: none;
    width: 0px;
}

#playButton {
    background-color: #7c4dff;
    border: none;
    border-radius: 0px;
    color: #ffffff;
    font-weight: 700;
    padding: 10px 28px;
}

#playButton:hover {
    background-color: #7c4dff;
}

#playButton:pressed {
    background-color: #7c4dff;
}

#searchBar {
    background-color: #131419;
    border: 1px solid #262a36;
    border-radius: 0px;
    padding: 8px 18px;
}

#searchBar:focus {
    border: 1px solid #7c4dff;
}

#sidebarPanel {
    background-color: #0f1117;
    border-right: 1px solid #20232c;
}

#sidebarButton {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    text-align: left;
    padding: 12px 16px;
    color: #8d8fa3;
    font-weight: 600;
}

#sidebarButton:hover {
    background-color: #121319;
    color: #eef0f5;
}

#sidebarButton:checked {
    background-color: #7c4dff;
    color: #ffffff;
}

QWidget {
    background-color: #18121a;
    color: #ece6ee;
    font-family: "Segoe UI", "Inter", "Ubuntu", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: rgba(18, 20, 26, 235);
    border: 1px solid #2b232f;
    border-radius: 0;
}

QDialog QTabWidget::pane {
    background-color: #1a141c;
}

QDialog QLabel {
    color: #d7cfdc;
}

QMenuBar {
    background-color: #161018;
    color: #a69aad;
    border: none;
    border-bottom: 1px solid #231c27;
    padding: 6px 10px;
    spacing: 2px;
}

QMenuBar::item {
    background-color: transparent;
    border: none;
    padding: 6px 14px;
    margin: 0 1px;
    border-radius: 0px;
    font-weight: 500;
    color: #a69aad;
}

QMenuBar::item:selected {
    background-color: #211a25;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background-color: #d73dfe;
    color: #ffffff;
}

QMenu {
    background-color: #211a25;
    border: 1px solid #352a3a;
    border-radius: 10px;
    padding: 4px;
}

QMenu::item {
    padding: 4px 16px;
    border-radius: 0px;
    margin: 0px;
    font-size: 12px;
}

QMenu::item:selected {
    background-color: #d73dfe;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #dcdfe8;
    background-color: #0d0a0e;
}

QMenu::separator {
    height: 1px;
    background: #352a3a;
    margin: 3px 4px;
}

QPushButton {
    background-color: #271e2c;
    color: #ece6ee;
    border: 1px solid #352a3a;
    border-radius: 0px;
    padding: 9px 24px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #36263c;
    border: 1px solid #d73dfe;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #d73dfe;
    border: 1px solid #d73dfe;
    color: #ffffff;
    padding: 10px 24px 8px 24px;
}

QPushButton:disabled {
    background-color: #0d0a0e;
    color: #dcdfe8;
    border: 1px solid transparent;
}

QPushButton#primaryButton {
    background-color: #d73dfe;
    border: 1px solid #d73dfe;
    color: #ffffff;
    border-radius: 0px;
}

QPushButton#primaryButton:hover {
    background-color: #d73dfe;
    border: 1px solid #d73dfe;
}

QPushButton#primaryButton:pressed {
    background-color: #d73dfe;
    border: 1px solid #d73dfe;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 0px;
    padding: 8px;
}

QToolButton:hover {
    background-color: #36263c;
    border: 1px solid #d73dfe;
}

QToolButton:pressed {
    background-color: #d73dfe;
    border: 1px solid #d73dfe;
    padding: 9px 7px 7px 9px;
}
QToolButton:disabled {
    background-color: #0d0a0e;
    color: #dcdfe8;
    border: 1px solid transparent;
}

QMenuBar::item:disabled {
    background-color: #0d0a0e;
    color: #dcdfe8;
    border: 1px solid transparent;
}


QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #201924;
    border: 1px solid #352a3a;
    border-radius: 0px;
    padding: 6px 10px;
    selection-background-color: #d73dfe;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus {
    border: 1px solid #d73dfe;
}

QComboBox {
    background-color: #201924;
    border: 1px solid #352a3a;
    border-radius: 0px;
    padding: 6px 12px;
}

QComboBox:hover {
    border: 1px solid #d73dfe;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #211a25;
    border: 1px solid #352a3a;
    border-radius: 0px;
    selection-background-color: #d73dfe;
    outline: none;
    padding: 4px;
}

QCheckBox, QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 0px;
    border: 1px solid #463a4c;
    background-color: #201924;
}

QRadioButton::indicator {
    border-radius: 0px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #d73dfe;
    border: 1px solid #d73dfe;
}

/* Disabled state for form controls -- previously only QPushButton had a
   :disabled rule, so checkboxes, radio buttons, combo/spin/line edits and
   plain disabled labels all still rendered at full brightness with no way
   to tell they weren't interactive. */
QCheckBox:disabled, QRadioButton:disabled, QLabel:disabled, QGroupBox:disabled {
    background-color: #0d0a0e;
    color: #dcdfe8;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #0d0a0e;
    border: 1px solid transparent;
}

QComboBox:disabled, QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #0d0a0e;
    border: 1px solid transparent;
    color: #dcdfe8;
}


QSlider::groove:horizontal {
    height: 6px;
    background: #2b232f;
    border-radius: 0px;
}

QSlider::handle:horizontal {
    background: #d73dfe;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 0px;
}

QSlider::handle:horizontal:hover {
    background: #d73dfe;
}

QSlider::sub-page:horizontal {
    background: #d73dfe;
    border-radius: 0px;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #352a3a;
    border-radius: 0px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #d73dfe;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #352a3a;
    border-radius: 0px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #d73dfe;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QTabWidget::pane {
    border: 1px solid #2b232f;
    border-radius: 0px;
    top: -1px;
}

QTabBar::tab {
    background: #1e1721;
    color: #a69aad;
    padding: 10px 20px;
    margin-right: 4px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QTabBar::tab:selected {
    background: #271e2c;
    color: #ffffff;
    border-bottom: 2px solid #d73dfe;
}

QTabBar::tab:hover:!selected {
    background: #211a25;
    color: #d7cfdc;
}

QGroupBox {
    border: 1px solid #2b232f;
    border-radius: 0px;
    margin-top: 14px;
    padding-top: 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #a69aad;
}

QStatusBar {
    background: #1e1721;
    border-top: 1px solid #2b232f;
    color: #a69aad;
}

QToolTip {
    background-color: #271e2c;
    color: #ece6ee;
    border: 1px solid #d73dfe;
    border-radius: 0px;
    padding: 6px 10px;
}

QListView, QTreeView, QTableView {
    background-color: #1a141c;
    border: 1px solid #2b232f;
    border-radius: 0px;
    outline: none;
    padding: 8px;
}

QListView::item {
    border-radius: 0px;
    padding: 10px;
    margin: 4px;
}

QListView::item:hover {
    background-color: #271e2c;
}

QListView::item:selected {
    background-color: #d73dfe;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #1e1721;
    color: #a69aad;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #2b232f;
}

QSplitter::handle {
    background: #2b232f;
}

QProgressBar {
    background-color: #201924;
    border-radius: 0px;
    text-align: center;
    color: #ece6ee;
    border: 1px solid #352a3a;
}

QProgressBar::chunk {
    background-color: #d73dfe;
    border-radius: 0px;
}

#libraryScreen {
    /* background is painted by LibraryScreen's animated gradient */
    background-color: transparent;
}

#libraryHeader {
    background-color: #1a141c;
    border-bottom: 1px solid #2b232f;
    padding: 16px;
}

#libraryTitle {
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
}

#gameCard {
    background-color: #211a25;
    border: 1px solid #302636;
    border-radius: 0px;
    color: #ece6ee;
    font-weight: 600;
    padding-top: 8px;
}

#gameCard:hover {
    background-color: #2a212f;
    border: 1px solid #d73dfe;
}

#gameCard:pressed {
    background-color: #36263c;
    border: 1px solid #d73dfe;
    padding-top: 10px;
}

#gameCardTitle {
    font-weight: 600;
    color: #ffffff;
    font-size: 13px;
}

#gameCardSubtitle {
    color: #8c7d94;
    font-size: 11px;
}

#addGameTile {
    background-color: transparent;
    border: 2px dashed #352a3a;
    border-radius: 0px;
    color: #625668;
    font-size: 34px;
    font-weight: 300;
}

#addGameTile:hover {
    border: 2px dashed #d73dfe;
    color: #d73dfe;
    background-color: #1e1621;
}

#addGameTile:pressed {
    border: 2px solid #d73dfe;
    color: #d73dfe;
    background-color: #2c1e30;
}

#titleBarToolBar, #topMenuToolBar, QToolBar {
    background: transparent;
    border: none;
    spacing: 0px;
    padding: 0px;
    margin: 0px;
}

#customTitleBar {
    background-color: #140e16;
    border-bottom: 1px solid #231c27;
}

#titleBarLabel {
    color: #a69aad;
    font-weight: 600;
    font-size: 12px;
}

#titleBarButton {
    background: transparent;
    border: none;
    border-radius: 0px;
}

#titleBarCloseButton {
    background: transparent;
    border: none;
    border-radius: 0px;
}

#topMenuBar {
    background-color: #161018;
    border-bottom: 1px solid #231c27;
}

#topMenuButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 0px;
    font-weight: 600;
    font-size: 13px;
    color: #c2b7c8;
    padding: 2px 4px 3px 4px;
}

#topMenuButton:hover {
    background-color: #2b1c30;
    border: 1px solid #d73dfe;
    color: #ffffff;
}

#topMenuButton:pressed {
    background-color: #36263c;
    border: 1px solid #d73dfe;
    padding: 7px 4px 3px 4px;
}

#topMenuButton:disabled {
    background-color: #0d0a0e;
    color: #dcdfe8;
    border: 1px solid transparent;
}

#topMenuButton::menu-indicator {
    image: none;
    width: 0px;
}

#playButton {
    background-color: #d73dfe;
    border: none;
    border-radius: 0px;
    color: #ffffff;
    font-weight: 700;
    padding: 10px 28px;
}

#playButton:hover {
    background-color: #d73dfe;
}

#playButton:pressed {
    background-color: #d73dfe;
}

#searchBar {
    background-color: #201924;
    border: 1px solid #352a3a;
    border-radius: 0px;
    padding: 8px 18px;
}

#searchBar:focus {
    border: 1px solid #d73dfe;
}

#sidebarPanel {
    background-color: #150f17;
    border-right: 1px solid #2b232f;
}

#sidebarButton {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    text-align: left;
    padding: 12px 16px;
    color: #a69aad;
    font-weight: 600;
}

#sidebarButton:hover {
    background-color: #211a25;
    color: #ece6ee;
}

#sidebarButton:checked {
    background-color: #d73dfe;
    color: #ffffff;
}

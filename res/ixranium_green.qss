QWidget {
    background-color: #121a14;
    color: #e6eee8;
    font-family: "Segoe UI", "Inter", "Ubuntu", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: rgba(18, 20, 26, 235);
    border: 1px solid #232f25;
    border-radius: 18px;
}

QDialog QTabWidget::pane {
    background-color: #141c16;
}

QDialog QLabel {
    color: #cfdcd1;
}

QMenuBar {
    background-color: #101812;
    color: #9aad9d;
    border: none;
    border-bottom: 1px solid #1c271e;
    padding: 6px 10px;
    spacing: 2px;
}

QMenuBar::item {
    background-color: transparent;
    border: none;
    padding: 6px 14px;
    margin: 0 1px;
    border-radius: 8px;
    font-weight: 500;
    color: #9aad9d;
}

QMenuBar::item:selected {
    background-color: #1a251c;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background-color: #3dfe77;
    color: #ffffff;
}

QMenu {
    background-color: #1a251c;
    border: 1px solid #2a3a2d;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 20px;
    border-radius: 6px;
    margin: 2px;
}

QMenu::item:selected {
    background-color: #3dfe77;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #2a3a2d;
    margin: 6px 4px;
}

QPushButton {
    background-color: #1e2c20;
    color: #e6eee8;
    border: 1px solid #2a3a2d;
    border-radius: 24px;
    padding: 9px 24px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #263c2b;
    border: 1px solid #5cff8d;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #6cff95;
    border: 1px solid #8fffb0;
    color: #ffffff;
    padding: 10px 24px 8px 24px;
}

QPushButton:disabled {
    background-color: #18201a;
    color: #566859;
    border: 1px solid #212c23;
}

QPushButton#primaryButton {
    background-color: #3dfe77;
    border: 1px solid #3dfe77;
    color: #ffffff;
    border-radius: 24px;
}

QPushButton#primaryButton:hover {
    background-color: #5cff8d;
    border: 1px solid #8fffb0;
}

QPushButton#primaryButton:pressed {
    background-color: #8fffb0;
    border: 1px solid #c2ffd3;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 22px;
    padding: 8px;
}

QToolButton:hover {
    background-color: #263c2b;
    border: 1px solid #3dfe77;
}

QToolButton:pressed {
    background-color: #6cff95;
    border: 1px solid #8fffb0;
    padding: 9px 7px 7px 9px;
}
QToolButton:disabled {
    background-color: #18201a;
    color: #566859;
    border: 1px solid #212c23;
}

QMenuBar::item:disabled {
    background-color: #18201a;
    color: #566859;
    border: 1px solid #212c23;
}


QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #19241b;
    border: 1px solid #2a3a2d;
    border-radius: 10px;
    padding: 6px 10px;
    selection-background-color: #3dfe77;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus {
    border: 1px solid #3dfe77;
}

QComboBox {
    background-color: #19241b;
    border: 1px solid #2a3a2d;
    border-radius: 10px;
    padding: 6px 12px;
}

QComboBox:hover {
    border: 1px solid #3dfe77;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #1a251c;
    border: 1px solid #2a3a2d;
    border-radius: 10px;
    selection-background-color: #3dfe77;
    outline: none;
    padding: 4px;
}

QCheckBox, QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1px solid #3a4c3d;
    background-color: #19241b;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #3dfe77;
    border: 1px solid #3dfe77;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #232f25;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #3dfe77;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: #5cff8d;
}

QSlider::sub-page:horizontal {
    background: #3dfe77;
    border-radius: 3px;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #2a3a2d;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #3dfe77;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #2a3a2d;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #3dfe77;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QTabWidget::pane {
    border: 1px solid #232f25;
    border-radius: 12px;
    top: -1px;
}

QTabBar::tab {
    background: #172118;
    color: #9aad9d;
    padding: 10px 20px;
    margin-right: 4px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QTabBar::tab:selected {
    background: #1e2c20;
    color: #ffffff;
    border-bottom: 2px solid #3dfe77;
}

QTabBar::tab:hover:!selected {
    background: #1a251c;
    color: #cfdcd1;
}

QGroupBox {
    border: 1px solid #232f25;
    border-radius: 14px;
    margin-top: 14px;
    padding-top: 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #9aad9d;
}

QStatusBar {
    background: #172118;
    border-top: 1px solid #232f25;
    color: #9aad9d;
}

QToolTip {
    background-color: #1e2c20;
    color: #e6eee8;
    border: 1px solid #3dfe77;
    border-radius: 8px;
    padding: 6px 10px;
}

QListView, QTreeView, QTableView {
    background-color: #141c16;
    border: 1px solid #232f25;
    border-radius: 14px;
    outline: none;
    padding: 8px;
}

QListView::item {
    border-radius: 12px;
    padding: 10px;
    margin: 4px;
}

QListView::item:hover {
    background-color: #1e2c20;
}

QListView::item:selected {
    background-color: #3dfe77;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #172118;
    color: #9aad9d;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #232f25;
}

QSplitter::handle {
    background: #232f25;
}

QProgressBar {
    background-color: #19241b;
    border-radius: 8px;
    text-align: center;
    color: #e6eee8;
    border: 1px solid #2a3a2d;
}

QProgressBar::chunk {
    background-color: #3dfe77;
    border-radius: 8px;
}

#libraryScreen {
    /* background is painted by LibraryScreen's animated gradient */
    background-color: transparent;
}

#libraryHeader {
    background-color: #141c16;
    border-bottom: 1px solid #232f25;
    padding: 16px;
}

#libraryTitle {
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
}

#gameCard {
    background-color: #1a251c;
    border: 1px solid #263628;
    border-radius: 20px;
    color: #e6eee8;
    font-weight: 600;
    padding-top: 8px;
}

#gameCard:hover {
    background-color: #212f23;
    border: 1px solid #3dfe77;
}

#gameCard:pressed {
    background-color: #263c2b;
    border: 1px solid #6cff95;
    padding-top: 10px;
}

#gameCardTitle {
    font-weight: 600;
    color: #ffffff;
    font-size: 13px;
}

#gameCardSubtitle {
    color: #7d9480;
    font-size: 11px;
}

#addGameTile {
    background-color: transparent;
    border: 2px dashed #2a3a2d;
    border-radius: 20px;
    color: #566859;
    font-size: 34px;
    font-weight: 300;
}

#addGameTile:hover {
    border: 2px dashed #3dfe77;
    color: #5cff8d;
    background-color: #162119;
}

#addGameTile:pressed {
    border: 2px solid #6cff95;
    color: #6cff95;
    background-color: #1e3023;
}

#titleBarToolBar, #topMenuToolBar, QToolBar {
    background: transparent;
    border: none;
    spacing: 0px;
    padding: 0px;
    margin: 0px;
}

#customTitleBar {
    background-color: #0e1610;
    border-bottom: 1px solid #1c271e;
}

#titleBarLabel {
    color: #9aad9d;
    font-weight: 600;
    font-size: 12px;
}

#titleBarButton {
    background: transparent;
    border: none;
    border-radius: 6px;
}

#titleBarCloseButton {
    background: transparent;
    border: none;
    border-radius: 6px;
}

#topMenuBar {
    background-color: #101812;
    border-bottom: 1px solid #1c271e;
}

#topMenuButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    font-weight: 600;
    font-size: 13px;
    color: #b7c8ba;
    padding: 2px 4px 3px 4px;
}

#topMenuButton:hover {
    background-color: #1c3021;
    border: 1px solid #3dfe77;
    color: #ffffff;
}

#topMenuButton:pressed {
    background-color: #263c2b;
    border: 1px solid #6cff95;
    padding: 7px 4px 3px 4px;
}

#topMenuButton:disabled {
    background-color: #18201a;
    color: #566859;
    border: 1px solid #212c23;
}

#topMenuButton::menu-indicator {
    image: none;
    width: 0px;
}

#playButton {
    background-color: #3dfe77;
    border: none;
    border-radius: 24px;
    color: #ffffff;
    font-weight: 700;
    padding: 10px 28px;
}

#playButton:hover {
    background-color: #5cff8d;
}

#playButton:pressed {
    background-color: #2dcc5f;
}

#searchBar {
    background-color: #19241b;
    border: 1px solid #2a3a2d;
    border-radius: 20px;
    padding: 8px 18px;
}

#searchBar:focus {
    border: 1px solid #3dfe77;
}

#sidebarPanel {
    background-color: #0f1711;
    border-right: 1px solid #232f25;
}

#sidebarButton {
    background-color: transparent;
    border: none;
    border-radius: 14px;
    text-align: left;
    padding: 12px 16px;
    color: #9aad9d;
    font-weight: 600;
}

#sidebarButton:hover {
    background-color: #1a251c;
    color: #e6eee8;
}

#sidebarButton:checked {
    background-color: #1e5c2e;
    color: #ffffff;
}
